<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/Fast2/SteamLibrary/steamapps/common/Moon Sweepers</GameDir>
    <Managed>$(GameDir)/MoonSweepers_Data/Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="lib/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="lib/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(GameDir)/BepInEx')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/BepInEx/plugins" />
  </Target>
</Project>
